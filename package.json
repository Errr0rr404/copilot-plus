    "macros",
    "command-palette",
    "text-to-speech",
    "tts",
    "clipboard",
    "context",
    "history",
    "bookmarks",
    "secrets-scanner",
    "plugins",
    "themes",
    "workflows",
    "prompt-queue",
    "usage",
    "worktree",
    "linux"
  ],
