{
  "name": "copilot-plus",
  "version": "1.2.0",
  "description": "Voice + screenshots + smart context + clipboard + shell + TTS + history + bookmarks + workflows + queue + plugins — drop-in wrapper for GitHub Copilot CLI",
  "bin": {
    "copilot+": "bin/copilot+"
  },
  "scripts": {
    "setup": "node \"bin/copilot+\" --setup",
    "test": "node tests/run.js",
    "postinstall": "node scripts/postinstall.js"
  },
